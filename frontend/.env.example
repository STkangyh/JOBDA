# API 서버는 이 프로젝트의 api/ 폴더(Vercel 함수)에 있다. 배포 빌드는 같은 출처의 /api/... 를 부른다.
# 개발 서버(npm run dev)에서는 비워두면 목데이터(src/api/mock)로 동작한다.
# 배포된 API를 로컬에서 부르려면 그 주소를 넣고, 서버 쪽 ALLOWED_ORIGIN에 http://localhost:5173 을 추가한다.
VITE_API_BASE_URL=

# API 서버 환경변수(Vercel 프로젝트에만 설정, 절대 VITE_ 접두사를 붙이지 말 것 — 브라우저에 노출된다)
# OPENAI_API_KEY=  /  LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY=  /  MODEL=  /  ALLOWED_ORIGIN=

# 사용자 활동 로그(Supabase). 비워두면 활동 로그 전송이 꺼진다.
# 테이블/권한은 ../supabase/migrations/ 의 SQL로 만든다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
